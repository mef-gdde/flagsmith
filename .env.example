# Copy this file to .env to customise the root Docker Compose deployment.

# Local image built from this fork by `docker compose up --build`.
FLAGSMITH_IMAGE=flagsmith-fork:local

# Use an externally managed PostgreSQL database by replacing this URL.
DATABASE_URL=postgresql://postgres:password@postgres:5432/flagsmith

# Maximum projects per free organisation. Use 0 for no limit.
MAX_PROJECTS_IN_FREE_PLAN=0

COMPOSE_PROJECT_NAME=dataef

# Ports published on the Docker host.
FLAGSMITH_PORT=8005
FLAGSMITH_TASK_PROCESSOR_PORT=7778
FRONTEND_PORT=8888

# Login & Registration Options
PREVENT_SIGNUP="true"
PREVENT_SAML="true"
PREVENT_OAUTH="true"
PREVENT_EMAIL_PASSWORD="false"
PREVENT_FORGOT_PASSWORD="false"

# Global network shared by every service. Set DATAEF_NETWORK_EXTERNAL=true only
# when the named network has already been created outside this Compose project.
DATAEF_NETWORK_NAME=dataef-network
DATAEF_NETWORK_EXTERNAL=false

