# Leave empty to create local images named flagsmith-api and
# flagsmith-frontend. Set this to a registry namespace when pushing, for
# example: ghcr.io/your-organisation
REGISTRY=

# Docker image tag applied to both images.
TAG=local

# Use one platform for local --load builds.
PLATFORM=linux/arm64

# For a multi-platform registry build, use:
# PLATFORM=linux/amd64,linux/arm64
# Then run: bash build.sh --push
